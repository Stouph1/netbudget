{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production"
    },
    "test": {
      "channel": "test",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "sandbox": {
      "channel": "sandbox",
      "android": {
        "buildType": "apk"
      }
    },
    "store": {
      "extends": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6763551701"
      }
    },
    "test": {
      "ios": {
        "ascAppId": "6763551701"
      }
    },
    "store": {
      "ios": {
        "ascAppId": "6763551701"
      }
    }
  }
}
