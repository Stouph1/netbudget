EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-jwt

# Facturation (RevenueCat). Clés PUBLIQUES du SDK, une par plateforme :
# app.revenuecat.com > Project settings > API keys > Public app-specific keys.
# Ce sont bien les clés « app-specific », jamais la clé secrète (v2 / sk_) qui
# ne doit exister que côté serveur.
#
# Poser une de ces clés MET LA FACTURATION EN SERVICE : l'app cesse d'utiliser
# le palier de développement et demande le vrai palier au serveur (my_tier()).
# Tant qu'elles sont absentes, l'écran des formules montre le contenu de
# l'abonnement sans bouton d'achat.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
