---
import "../styles/globals.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import { useTranslations, isRtl, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  pageKind?: "home" | "page";
  /** Image de partage propre à la page. Sans elle, on retombe sur celle de l'accueil. */
  ogImage?: string;
  /** Données structurées supplémentaires (FAQ, fil d'Ariane…). */
  schema?: unknown;
  /** Retire la page de l'index — pages sans intérêt d'entrée (remerciement, 404). */
  noindex?: boolean;
  /** Masque la barre d'action mobile : inutile sur une page légale ou d'erreur. */
  hideStickyCta?: boolean;
}

const {
  locale,
  title,
  description,
  pageKind = "home",
  ogImage,
  schema,
  noindex = false,
  hideStickyCta = false,
} = Astro.props;

const t = useTranslations(locale);
const dir = isRtl(locale) ? "rtl" : "ltr";

const SITE = "https://netbudget.app";

// L'accroche est découpée en trois morceaux dans le catalogue (pour styliser
// l'accent à l'écran) : les recoller tous, sinon le titre anglais s'arrête sur
// « Know what you really » et ne veut rien dire.
const pageTitle =
  title ??
  `NETbudget — ${t("hero.title")} ${t("hero.title.accent")}${t("hero.title.suffix")}`.replace(
    /\s+/g,
    " ",
  ).replace(/\s\./, ".").trim();
const pageDesc = description ?? t("hero.subtitle");

// Canonique : indispensable dès qu'une page est atteignable par plusieurs
// chemins (avec ou sans slash final, avec des paramètres de campagne). Sans
// elle, les moteurs répartissent l'autorité entre des doublons.
//
// SANS slash final, et ce n'est pas un détail : vercel.json déclare
// `trailingSlash: false`, donc l'hébergeur sert `/faq` et redirige `/faq/`.
// Une canonique qui pointe vers une redirection est une canonique cassée —
// elle désigne une page qui n'est pas celle qu'on lit.
const cleanPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonical = new URL(cleanPath, SITE).href;

const shareImage = new URL(
  ogImage ?? (locale === "en" ? "/og-image-en.png" : "/og-image.png"),
  SITE,
).href;

// L'application elle-même, décrite pour les moteurs. `SoftwareApplication` et
// non `LocalBusiness` : NETbudget n'a ni adresse, ni horaires, ni zone de
// chalandise — un balisage de commerce local sur une app serait ignoré au
// mieux, considéré comme trompeur au pire.
const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "NETbudget",
  applicationCategory: "FinanceApplication",
  operatingSystem: "iOS, Android",
  url: SITE,
  inLanguage: ["fr", "en", "es", "pt", "de", "it", "ar", "ja"],
  description: pageDesc,
  image: shareImage,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
    description:
      locale === "en"
        ? "Free, no account required. Optional subscription for syncing and shared budgets."
        : "Gratuit, sans compte. Abonnement facultatif pour la synchronisation et les budgets partagés.",
  },
  author: {
    "@type": "Person",
    name: "Stéphane Pizeuil",
    url: "https://www.linkedin.com/in/stephane-p-aa6122186/",
  },
  publisher: {
    "@type": "Organization",
    name: "NETbudget",
    url: SITE,
    logo: new URL("/logo.png", SITE).href,
    sameAs: ["https://www.instagram.com/netbudget.app"],
  },
};

// Un seul bloc JSON-LD : plusieurs balises séparées sont valides, mais un
// @graph est plus lisible et évite les entités dupliquées.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": schema ? [appSchema, schema] : [appSchema],
};
---

<!doctype html>
<html lang={locale} dir={dir} class="bg-ink-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0A0A0C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}

    <meta property="og:site_name" content="NETbudget" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* Décrit l'aperçu aux lecteurs d'écran des réseaux qui l'exposent. */}
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content={locale === "en" ? "en_GB" : "fr_FR"} />
    <meta property="og:locale:alternate" content={locale === "en" ? "fr_FR" : "en_GB"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={shareImage} />

    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />
    <link rel="alternate" hreflang="fr" href={`${SITE}/`} />
    <link rel="alternate" hreflang="en" href={`${SITE}/en`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="font-sans">
    {/* Lien d'évitement : premier élément focusable, visible seulement au
        clavier. Sans lui, chaque page commence par traverser toute la barre
        de navigation avant d'atteindre le contenu. */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:inline-flex focus:min-h-11 focus:items-center focus:rounded-full focus:bg-mint-500 focus:px-5 focus:text-sm focus:font-semibold focus:text-ink-900"
    >
      {t("a11y.skip")}
    </a>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-mint-500 focus:px-3 focus:py-2 focus:text-ink-900"
    >
      {t("a11y.skipToContent")}
    </a>
    <Nav locale={locale} pageKind={pageKind} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    {hideStickyCta ? null : <StickyCta locale={locale} />}

    <script>
      // Reveal-on-scroll : ajoute la classe "reveal-visible" aux éléments .reveal
      // dès qu'ils entrent dans le viewport.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("reveal-visible");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
