---
import Phone from "./Phone.astro";
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const screens = [
  // Six captures prises dans l'app (simulateur iPhone, version 2.0), servies
  // en WebP 720 px avec le PNG en repli. L'alternative textuelle reprend le
  // libellé traduit.
  { src: "/screens/budget-720", key: "budget", tilt: "left" as const },
  { src: "/screens/depenses-720", key: "expenses", tilt: "none" as const },
  { src: "/screens/reperes-720", key: "benchmark", tilt: "right" as const },
  { src: "/screens/annee-720", key: "year", tilt: "left" as const },
  { src: "/screens/notifications-720", key: "notifications", tilt: "none" as const },
  { src: "/screens/convertir-720", key: "converter", tilt: "right" as const },
].map((x) => ({ ...x, alt: t(`screens.${x.key}`), label: t(`screens.${x.key}`) }));
---

<section id="screens" class="relative overflow-hidden">
  <div class="container-app py-20 md:py-28">
    <div class="mx-auto max-w-3xl text-center reveal">
      <span class="eyebrow">{t("screens.eyebrow")}</span>
      <h2 class="heading-2 mt-4 text-balance">{t("screens.title")}</h2>
      <p class="body-lg mt-4 text-balance">{t("screens.subtitle")}</p>
    </div>

    <div class="mt-14 grid items-end gap-10 sm:grid-cols-2 md:grid-cols-3 md:gap-x-4 md:gap-y-14">
      {screens.map((s, i) => (
        <div class="flex flex-col items-center gap-4 reveal" style={`animation-delay: ${i * 100}ms`}>
          <Phone src={s.src} alt={s.alt} tilt={s.tilt} size="md" />
          <span class="text-sm font-semibold text-text-2">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
