---
// Barre de navigation.
//
// TROIS PROBLÈMES CORRIGÉS ICI :
//
// 1. « Confidentialité » menait au bloc MARKETING de l'accueil, pas au
//    document. Quelqu'un qui cherche la politique atterrissait sur un argument
//    de vente. L'ancre garde donc un intitulé qui décrit la promesse
//    (« Vie privée ») et le document vit dans un menu « Légal » explicite.
//
// 2. Sur toute page autre que l'accueil, la navigation était VIDE : depuis la
//    politique de confidentialité, aucun moyen d'aller ailleurs que par le
//    logo. Les liens de pages sont maintenant permanents.
//
// 3. Rien n'était accessible sur mobile, où la navigation entière était
//    masquée. Le menu « Légal » y reste atteignable.
import { useTranslations, localizedPath, LOCALES, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
  pageKind?: "home" | "page";
}

const { locale, pageKind = "home" } = Astro.props;
const t = useTranslations(locale);
const home = localizedPath(locale, "/");

// Les documents que l'on doit pouvoir trouver sans chercher. Un utilisateur qui
// veut vérifier ce qu'on fait de ses données ne doit pas avoir à descendre
// jusqu'au pied de page.
const legalLinks = [
  { href: "/privacy", label: t("page.privacy.title"), icon: "shield" },
  { href: "/terms", label: t("page.terms.title"), icon: "file" },
] as const;
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-white/[0.06] bg-ink-900/70 backdrop-blur-xl">
  <div class="container-app flex h-16 items-center justify-between gap-3">
    <a href={home} class="group flex shrink-0 items-center gap-2.5">
      <img
        src="/logo.png"
        alt="NETbudget"
        width="32"
        height="32"
        class="h-8 w-8 rounded-lg shadow-lg shadow-mint-500/20"
      />
      <span
        class="font-bold tracking-tight text-text-1 transition group-hover:text-mint-400"
      >NETbudget</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm md:flex" aria-label={t("nav.label")}>
      {
        pageKind === "home" && (
          <>
            <a href="#features" class="text-text-2 transition hover:text-text-1">
              {t("nav.features")}
            </a>
            <a href="#whatsnew" class="text-text-2 transition hover:text-text-1">
              {t("nav.whatsnew")}
            </a>
            <a href="#reviews" class="text-text-2 transition hover:text-text-1">
              {t("nav.reviews")}
            </a>
            <a href="#privacy" class="text-text-2 transition hover:text-text-1">
              {t("nav.privacyPromise")}
            </a>
          </>
        )
      }
      <a
        href={localizedPath(locale, "/faq")}
        class="text-text-2 transition hover:text-text-1"
      >
        {t("nav.faq")}
      </a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      {/* Menu légal : visible à toutes les tailles d'écran, contrairement au
          reste de la navigation. C'est le seul point d'entrée vers les
          documents sur mobile. */}
      <details class="group/legal relative" data-nav-menu>
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-text-2 transition hover:text-text-1"
          aria-label={t("nav.legal")}
        >
          <svg
            width="13"
            height="13"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>{t("nav.legal")}</span>
          <svg
            width="11"
            height="11"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="transition group-open/legal:rotate-180"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>

        <div
          class="absolute right-0 mt-2 w-64 rounded-xl border border-white/10 bg-ink-800/95 p-1.5 shadow-2xl backdrop-blur-xl"
        >
          {
            legalLinks.map((l) => (
              <a
                href={localizedPath(locale, l.href)}
                class="flex items-start gap-2.5 rounded-lg px-3 py-2.5 text-sm text-text-2 transition hover:bg-white/5 hover:text-text-1"
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="mt-0.5 shrink-0 text-mint-400"
                >
                  {l.icon === "shield" ? (
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  ) : (
                    <>
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                      <polyline points="14 2 14 8 20 8" />
                    </>
                  )}
                </svg>
                <span>{l.label}</span>
              </a>
            ))
          }

          <div class="my-1.5 h-px bg-white/[0.08]"></div>

          <a
            href="mailto:contact@netbudget.app"
            class="flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm text-text-2 transition hover:bg-white/5 hover:text-text-1"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="shrink-0 text-mint-400"
            >
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
              ></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>{t("footer.contact")}</span>
          </a>
        </div>
      </details>

      <details class="relative" data-nav-menu>
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-text-2 transition hover:text-text-1"
          aria-label={t("footer.lang")}
        >
          {LOCALES.find((l) => l.code === locale)?.flag}
          <span class="uppercase">{locale}</span>
        </summary>
        <div
          class="absolute right-0 mt-2 w-44 rounded-xl border border-white/10 bg-ink-800/95 p-1.5 shadow-2xl backdrop-blur-xl"
        >
          {
            LOCALES.map((l) => (
              <a
                href={localizedPath(l.code, "/")}
                class:list={[
                  "flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm transition",
                  l.code === locale
                    ? "bg-white/10 text-text-1"
                    : "text-text-2 hover:bg-white/5 hover:text-text-1",
                ]}
              >
                <span>{l.flag}</span>
                <span>{l.label}</span>
              </a>
            ))
          }
        </div>
      </details>

      <a href={`${home}#download`} class="btn-primary hidden !px-4 !py-2 text-xs sm:inline-flex">
        {t("nav.download")}
      </a>
    </div>
  </div>
</header>
<div class="h-16"></div>

<script>
  // Deux menus <details> côte à côte : sans ça, ouvrir le second laisse le
  // premier ouvert et les panneaux se chevauchent. On ferme aussi au clic
  // ailleurs et à la touche Échap, ce que <details> ne fait pas seul.
  const menus = Array.from(
    document.querySelectorAll<HTMLDetailsElement>("[data-nav-menu]"),
  );

  for (const menu of menus) {
    menu.addEventListener("toggle", () => {
      if (!menu.open) return;
      for (const other of menus) if (other !== menu) other.open = false;
    });
  }

  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    for (const menu of menus) {
      if (menu.open && !menu.contains(target)) menu.open = false;
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    for (const menu of menus) menu.open = false;
  });
</script>
