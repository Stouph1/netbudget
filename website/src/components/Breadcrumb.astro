---
// Fil d'Ariane.
//
// Deux rôles distincts, et le second est le plus utile :
//  - à l'écran, il montre où l'on est et permet de remonter d'un cran ;
//  - dans les résultats de recherche, le balisage BreadcrumbList remplace
//    l'URL brute par un chemin lisible sous le titre.
//
// Le dernier élément n'est PAS un lien : cliquer sur la page où l'on se trouve
// déjà n'apporte rien, et les lecteurs d'écran l'annoncent comme la position
// courante grâce à aria-current.
import { localizedPath, useTranslations, type Locale } from "../i18n/utils";

export interface Crumb {
  label: string;
  /** Chemin sans préfixe de langue. Absent = page courante. */
  href?: string;
}

interface Props {
  locale: Locale;
  items: Crumb[];
}

const { locale, items } = Astro.props;
const t = useTranslations(locale);

// L'accueil est toujours la première marche : on l'ajoute ici plutôt que de le
// répéter sur chaque page.
const crumbs: Crumb[] = [{ label: t("breadcrumb.home"), href: "/" }, ...items];
---

<nav aria-label={t("breadcrumb.label")} class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-text-3">
    {
      crumbs.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 ? (
            <span aria-hidden="true" class="select-none text-text-3/60">
              /
            </span>
          ) : null}
          {c.href && i < crumbs.length - 1 ? (
            <a
              href={localizedPath(locale, c.href)}
              class="text-text-2 transition hover:text-mint-400"
            >
              {c.label}
            </a>
          ) : (
            <span aria-current="page" class="text-text-2">
              {c.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
