---
// Section "tous les liens" — pensée pour être LA destination unique du lien
// Instagram (bio) et du bouton "Télécharger" de la nav : App Store, Google
// Play et inscription liste d'attente Premium, réunis au même endroit.
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const FORM_URL = "https://forms.gle/2YgnD2ReFVGpnXCa6";
// Le jour J : 15 octobre 2026, heure de Paris. Une seule source, lue par le
// script du compte à rebours et par la phrase de repli sans JavaScript.
const TEASER_AT = "2026-10-15T00:00:00+02:00";
const APPSTORE_URL = "https://apps.apple.com/app/netbudget/id6763551701";
const PLAYSTORE_URL = "https://play.google.com/store/apps/details?id=com.stouph.netbudget";
---

<section id="download" class="relative scroll-mt-20">
  <div class="container-app pb-16">
    <div class="reveal relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-mint-500/10 via-transparent to-cyan-400/5 p-8 text-center md:p-12">
      <div
        aria-hidden="true"
        class="absolute -top-24 left-1/2 -z-10 h-[280px] w-[560px] -translate-x-1/2 rounded-full bg-gradient-radial from-mint-500/20 to-transparent blur-2xl"
      >
      </div>

      <span class="eyebrow">{t("links.eyebrow")}</span>
      <h2 class="heading-2 mx-auto mt-3 max-w-xl text-balance">{t("links.title")}</h2>
      <p class="body-lg mx-auto mt-3 max-w-xl text-balance">{t("links.subtitle")}</p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={APPSTORE_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 14.44c.02 2.15 1.94 2.76 1.95 2.78-.02.05-.33 1.13-1.08 2.24-.64.95-1.31 1.9-2.37 1.92-1.07.02-1.38-.65-2.59-.65-1.21 0-1.56.63-2.57.67-1.03.04-1.81-1.03-2.46-1.97C6.59 16.48 5.59 12.99 6.97 10.61c.69-1.17 1.92-1.92 3.25-1.95 1.02-.02 1.97.69 2.59.69.62 0 1.78-.85 3-.72.5.02 1.94.21 2.85 1.54-.07.05-1.71.96-1.69 3.27zM14.77 7.34c.55-.67.91-1.6.81-2.51-.78.03-1.73.52-2.29 1.2-.52.6-.96 1.54-.85 2.43.88.07 1.77-.47 2.33-1.12z"></path>
          </svg>
          {t("hero.cta.appstore")}
        </a>
        <a href={PLAYSTORE_URL} target="_blank" rel="noopener noreferrer" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 20.5V3.5c0-.59.34-1.11.84-1.35L13.69 12 3.84 21.85A1.53 1.53 0 0 1 3 20.5zm13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27zm3.35-4.31c.34.27.59.69.59 1.19s-.25.92-.59 1.19l-2.27 1.31L15.39 12l2.5-2.5 2.27 1.31zM6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66z"></path>
          </svg>
          {t("hero.cta.googleplay")}
        </a>
      </div>

      <div class="mx-auto my-10 h-px w-full max-w-md bg-white/10"></div>

      {/* Le compte à rebours. La date est la seule donnée : tout le reste
          (jours, heures, minutes, secondes) est calculé dans le navigateur,
          et le bloc bascule seul en « c'est là » une fois l'heure passée.
          Sans JavaScript, la date en toutes lettres reste lisible. */}
      <div id="teaser" class="scroll-mt-24" data-teaser-at={TEASER_AT}>
        <div class="inline-flex items-center gap-2 rounded-full border border-mint-500/30 bg-mint-500/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-mint-400">
          <span aria-hidden="true" class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint-400 opacity-75 motion-reduce:hidden"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-mint-400"></span>
          </span>
          {t("teaser.eyebrow")}
        </div>

        <h3 class="mx-auto mt-5 max-w-2xl text-balance text-2xl font-bold tracking-tight md:text-3xl">
          <span data-teaser="before">{t("teaser.title")}</span>
          <span data-teaser="after" hidden>{t("teaser.live")}</span>
        </h3>

        <p class="sr-only" data-teaser="before">{t("teaser.dateLong")}</p>
        <div
          data-teaser="before"
          class="mx-auto mt-7 grid max-w-md grid-cols-4 gap-2 sm:gap-3"
          role="timer"
          aria-live="off"
        >
          {
            (["days", "hours", "minutes", "seconds"] as const).map((unit) => (
              <div class="rounded-2xl border border-white/10 bg-ink-900/60 px-2 py-4 sm:py-5">
                <span data-unit={unit} class="block text-3xl font-bold tabular-nums tracking-tight text-text-1 sm:text-4xl">
                  --
                </span>
                <span class="mt-1 block text-[11px] font-semibold uppercase tracking-[0.14em] text-text-3">
                  {t(`teaser.${unit}`)}
                </span>
              </div>
            ))
          }
        </div>

        <p class="body-lg mx-auto mt-6 max-w-xl text-balance">
          <span class="font-semibold text-text-1">{t("teaser.hintLabel")}</span> {t("teaser.hint")}
        </p>

        <a href={FORM_URL} target="_blank" rel="noopener noreferrer" class="btn-primary mt-8 inline-flex">
          {t("teaser.cta")}
        </a>
        <p class="mt-4 text-xs text-text-3">{t("teaser.note")}</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var root = document.getElementById("teaser");
    if (!root) return;
    var at = new Date(root.getAttribute("data-teaser-at")).getTime();
    var units = {
      days: root.querySelector('[data-unit="days"]'),
      hours: root.querySelector('[data-unit="hours"]'),
      minutes: root.querySelector('[data-unit="minutes"]'),
      seconds: root.querySelector('[data-unit="seconds"]'),
    };
    var before = root.querySelectorAll('[data-teaser="before"]');
    var after = root.querySelectorAll('[data-teaser="after"]');
    var pad = function (n) { return n < 10 ? "0" + n : String(n); };
    var timer;
    function tick() {
      var left = at - Date.now();
      if (left <= 0) {
        before.forEach(function (el) { el.hidden = true; });
        after.forEach(function (el) { el.hidden = false; });
        if (timer) clearInterval(timer);
        return;
      }
      var s = Math.floor(left / 1000);
      units.days.textContent = String(Math.floor(s / 86400));
      units.hours.textContent = pad(Math.floor((s % 86400) / 3600));
      units.minutes.textContent = pad(Math.floor((s % 3600) / 60));
      units.seconds.textContent = pad(s % 60);
    }
    tick();
    timer = setInterval(tick, 1000);
    // Onglet en arrière-plan : on ne compte pas dans le vide.
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) clearInterval(timer);
      else { tick(); timer = setInterval(tick, 1000); }
    });
  })();
</script>
