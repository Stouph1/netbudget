---
// Avis discret sur la mesure d'audience, avec le choix de la refuser.
//
// CE SITE NE POSE AUCUN COOKIE. La mesure Vercel est agrégée, sans cookie ni
// identifiant : la CNIL n'exige pas de consentement pour ce type de mesure.
// L'avis n'est donc pas une bannière de cookies, c'est une information vraie
// et un vrai choix : refuser, et le script de mesure n'est plus chargé.
//
// DISCRET, PAS INVISIBLE. Petit encart en bas, après un court délai, jamais
// modal, jamais devant le contenu. Le choix est mémorisé sur l'appareil ; le
// signal « Global Privacy Control » du navigateur vaut refus sans rien afficher.
// On peut revenir dessus depuis le pied de page.
import { useTranslations, localizedPath, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<aside
  id="consent-notice"
  class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-sm translate-y-3 pb-[env(safe-area-inset-bottom,0px)] opacity-0 transition-[transform,opacity] duration-300 sm:inset-x-auto sm:left-5 sm:right-auto motion-reduce:transition-none"
  aria-label={t("consent.label")}
  hidden
>
  <div class="rounded-2xl border border-white/10 bg-ink-800/95 p-4 shadow-2xl backdrop-blur-xl">
    <p class="text-[13px] leading-relaxed text-text-2">
      {t("consent.text")}
      <a href={localizedPath(locale, "/privacy")} class="text-mint-400 underline-offset-2 hover:underline">{t("consent.more")}</a>
    </p>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <button
        type="button"
        data-consent="ok"
        class="inline-flex min-h-11 items-center rounded-full bg-mint-500 px-4 text-sm font-semibold text-ink-900 transition hover:bg-mint-400"
      >
        {t("consent.ok")}
      </button>
      <button
        type="button"
        data-consent="refused"
        class="inline-flex min-h-11 items-center rounded-full px-3 text-sm font-semibold text-text-2 transition hover:text-text-1"
      >
        {t("consent.refuse")}
      </button>
    </div>
  </div>
</aside>

<script>
  const KEY = "nb:consent";
  const notice = document.getElementById("consent-notice");
  if (notice) {
    const read = (): string | null => {
      try {
        return localStorage.getItem(KEY);
      } catch {
        return null;
      }
    };
    const gpc =
      (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true;

    const show = () => {
      notice.hidden = false;
      requestAnimationFrame(() => notice.classList.remove("translate-y-3", "opacity-0"));
    };
    const hide = () => {
      notice.classList.add("translate-y-3", "opacity-0");
      setTimeout(() => (notice.hidden = true), 300);
    };
    const choose = (value: "ok" | "refused") => {
      try {
        localStorage.setItem(KEY, value);
      } catch {}
      if (value === "refused") {
        // Le script a peut-être déjà démarré sur cette page : on le neutralise.
        // Les pages suivantes ne le chargeront plus (voir Layout).
        const w = window as Window & { va?: unknown };
        w.va = () => {};
        document.querySelector('script[src*="/_vercel/insights/"]')?.remove();
      }
      hide();
    };

    notice.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((b) =>
      b.addEventListener("click", () => choose(b.dataset.consent as "ok" | "refused")),
    );
    // Depuis le pied de page : revoir son choix.
    document.querySelectorAll("[data-consent-open]").forEach((el) =>
      el.addEventListener("click", (e) => {
        e.preventDefault();
        show();
      }),
    );

    // Rien à demander si la personne a déjà choisi, ou si son navigateur
    // refuse pour elle.
    if (read() === null && !gpc) setTimeout(show, 1400);
  }
</script>
