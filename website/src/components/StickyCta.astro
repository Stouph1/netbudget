---
// Barre d'action fixée en bas, sur mobile uniquement.
//
// DEUX RÈGLES qui font la différence entre une aide et une gêne :
//
// 1. Elle n'apparaît qu'après avoir dépassé le premier écran. Superposée au
//    héros, elle masquerait le bouton de téléchargement qui s'y trouve déjà —
//    on couvrirait l'appel à l'action avec un appel à l'action.
//
// 2. Elle s'effface quand le bloc final entre dans le champ, pour la même
//    raison. Insister quand la vraie carte est visible dessert le clic.
//
// Sur ordinateur, elle n'existe pas : la barre de navigation reste visible.
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const APP_STORE = "https://apps.apple.com/app/netbudget/id6763551701";
---

<div
  id="sticky-cta"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full opacity-0 transition-[transform,opacity] duration-300 md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom, 0px)"
  aria-hidden="true"
>
  <div class="border-t border-white/10 bg-ink-900/90 px-4 py-3 backdrop-blur-lg">
    <div class="flex items-center gap-3">
      <div class="min-w-0 flex-1">
        <p class="truncate text-sm font-semibold text-text-1">{t("sticky.title")}</p>
        <p class="truncate text-xs text-text-3">{t("sticky.sub")}</p>
      </div>
      <a
        href={APP_STORE}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 rounded-xl bg-mint-500 px-4 py-2.5 text-sm font-bold text-ink-900 transition active:scale-95"
      >
        {t("sticky.cta")}
      </a>
    </div>
  </div>
</div>

<script>
  const bar = document.getElementById("sticky-cta");
  if (bar) {
    const show = () => {
      bar.classList.remove("translate-y-full", "opacity-0", "pointer-events-none");
      bar.setAttribute("aria-hidden", "false");
    };
    const hide = () => {
      bar.classList.add("translate-y-full", "opacity-0", "pointer-events-none");
      bar.setAttribute("aria-hidden", "true");
    };

    // Le bloc final porte l'id "final-cta" ; s'il est à l'écran, on se retire.
    const finalCta = document.getElementById("final-cta");
    let finalVisible = false;

    if (finalCta) {
      new IntersectionObserver(
        (entries) => {
          finalVisible = entries[0].isIntersecting;
          if (finalVisible) hide();
          else if (window.scrollY > window.innerHeight * 0.9) show();
        },
        { threshold: 0.15 },
      ).observe(finalCta);
    }

    let last = 0;
    const onScroll = () => {
      const y = window.scrollY;
      // Seuil à ~90 % de la hauteur d'écran : on laisse le héros tranquille.
      if (y > window.innerHeight * 0.9 && !finalVisible) show();
      else if (y < window.innerHeight * 0.6) hide();
      last = y;
    };

    // `passive` : le défilement ne doit jamais attendre ce calcul.
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
