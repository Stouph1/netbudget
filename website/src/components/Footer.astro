---
import { useTranslations, localizedPath, LOCALES, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="border-t border-white/[0.06] bg-ink-900/60 backdrop-blur">
  <div class="container-app py-12">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <a href={localizedPath(locale, "/")} class="flex items-center gap-2.5">
          <img
            src="/logo-64.png"
            alt=""
            width="32"
            height="32"
            class="h-8 w-8 rounded-lg shadow-lg shadow-mint-500/20"
          />
          <span class="font-bold tracking-tight text-text-1">NETbudget</span>
        </a>
        <p class="mt-4 max-w-sm text-sm text-text-2">{t("footer.tagline")}</p>
        {/* L'indice : une ligne à peine visible, pour qui lit jusqu'en bas.
            Elle renvoie au compte à rebours de l'accueil. */}
        <p class="mt-2 text-xs text-text-3/70">
          <a href={localizedPath(locale, "/") + "#teaser"} class="transition hover:text-mint-400">{t("footer.hint")}</a>
        </p>
        <!-- Social icons sous la tagline -->
        <div class="mt-5 flex items-center gap-2">
          <a
            href="https://www.instagram.com/netbudget.app"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram NETbudget"
            class="group inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-text-2 transition hover:border-mint-500/40 hover:text-mint-400"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            href="https://www.tiktok.com/@netbudget.app"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok NETbudget"
            class="group inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-text-2 transition hover:border-mint-500/40 hover:text-mint-400"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
          </a>
          <a
            href="mailto:contact@netbudget.app"
            aria-label="Email"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-white/[0.04] text-text-2 transition hover:border-mint-500/40 hover:text-mint-400"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-text-3">{t("footer.links")}</p>
        <ul class="mt-2 text-sm">
          <li><a href={localizedPath(locale, "/privacy/")} class="inline-flex min-h-11 items-center text-text-2 hover:text-text-1 transition">{t("footer.privacy")}</a></li>
          <li><a href={localizedPath(locale, "/terms/")} class="inline-flex min-h-11 items-center text-text-2 hover:text-text-1 transition">{t("footer.terms")}</a></li>
          <li><a href="mailto:contact@netbudget.app" class="inline-flex min-h-11 items-center text-text-2 hover:text-text-1 transition">{t("footer.contact")}</a></li>
          <li><button type="button" data-consent-open class="inline-flex min-h-11 items-center text-left text-text-2 hover:text-text-1 transition">{t("footer.consent")}</button></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-text-3">{t("footer.follow")}</p>
        <ul class="mt-2 text-sm">
          <li>
            <a
              href="https://www.instagram.com/netbudget.app"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 text-text-2 hover:text-text-1 transition"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
              Instagram
            </a>
          </li>
          <li>
            <a
              href="https://www.tiktok.com/@netbudget.app"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 text-text-2 hover:text-text-1 transition"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              TikTok
            </a>
          </li>
          <li>
            <a
              href="https://apps.apple.com/app/netbudget/id6763551701"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 text-text-2 hover:text-text-1 transition"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.05 14.44c.02 2.15 1.94 2.76 1.95 2.78-.02.05-.33 1.13-1.08 2.24-.64.95-1.31 1.9-2.37 1.92-1.07.02-1.38-.65-2.59-.65-1.21 0-1.56.63-2.57.67-1.03.04-1.81-1.03-2.46-1.97C6.59 16.48 5.59 12.99 6.97 10.61c.69-1.17 1.92-1.92 3.25-1.95 1.02-.02 1.97.69 2.59.69.62 0 1.78-.85 3-.72.5.02 1.94.21 2.85 1.54-.07.05-1.71.96-1.69 3.27zM14.77 7.34c.55-.67.91-1.6.81-2.51-.78.03-1.73.52-2.29 1.2-.52.6-.96 1.54-.85 2.43.88.07 1.77-.47 2.33-1.12z"/>
              </svg>
              {t("footer.appstore")}
            </a>
          </li>
          <li>
            <a
              href="https://play.google.com/store/apps/details?id=com.stouph.netbudget"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center gap-2 text-text-2 hover:text-text-1 transition"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3 20.5V3.5c0-.59.34-1.11.84-1.35L13.69 12 3.84 21.85A1.53 1.53 0 0 1 3 20.5zm13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27zm3.35-4.31c.34.27.59.69.59 1.19s-.25.92-.59 1.19l-2.27 1.31L15.39 12l2.5-2.5 2.27 1.31zM6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66z"/>
              </svg>
              {t("footer.googleplay")}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-text-3">{t("footer.lang")}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {LOCALES.map((l) => (
            <a
              href={localizedPath(l.code, "/")}
              class:list={[
                "inline-flex min-h-11 items-center rounded-full border px-3 text-sm transition",
                l.code === locale
                  ? "border-mint-500/40 bg-mint-500/10 text-mint-400"
                  : "border-white/10 bg-white/[0.03] text-text-2 hover:text-text-1",
              ]}
              hreflang={l.code}
            >
              {l.flag} <span class="ml-1 uppercase">{l.code}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center gap-2 border-t border-white/[0.06] pt-6 text-xs text-text-3 sm:flex-row sm:justify-between">
      <span>{t("footer.copyright")}</span>
      <span class="flex items-center gap-1.5">
        {t("footer.madeby")}
        <a
          href="https://www.linkedin.com/in/stephane-p-aa6122186/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center font-medium text-text-2 hover:text-mint-400 transition"
        >
          Stéphane Pizeuil
        </a>
      </span>
    </div>
  </div>
</footer>
