---
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

// Animation de logo (sans son) — même fichier pour toutes les locales.
const videoSrc = "/videos/netbudget-logo-reveal.mp4";
---

<section class="relative overflow-hidden">
  <!-- Layered ambient glow behind the hero (mint + cyan radial) -->
  <div aria-hidden="true" class="absolute inset-0 -z-10">
    <div
      class="absolute -top-40 left-1/2 h-[700px] w-[1300px] -translate-x-1/2 rounded-full bg-gradient-radial from-mint-500/25 via-cyan-400/10 to-transparent blur-3xl"
    >
    </div>
  </div>

  <div class="container-app pt-10 pb-12 md:pt-20 md:pb-24">
    <div class="grid items-center gap-10 md:grid-cols-[1.05fr_0.95fr] md:gap-14">
      <!-- Left: copy + CTAs -->
      <div class="space-y-7 text-center md:text-left">
        <span class="eyebrow">{t("hero.eyebrow")}</span>

        <h1
          class="text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl leading-[1.05] text-balance"
        >
          {t("hero.title")}{" "}
          <span class="gradient-text">{t("hero.title.accent")}</span>{t("hero.title.suffix")}
        </h1>

        <p class="body-lg max-w-xl text-balance md:max-w-none">{t("hero.subtitle")}</p>

        <div class="flex flex-wrap items-center justify-center gap-3 md:justify-start">
          <a
            href="https://apps.apple.com/app/netbudget/id6763551701"
            target="_blank"
            rel="noopener"
            class="btn-primary"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M17.05 14.44c.02 2.15 1.94 2.76 1.95 2.78-.02.05-.33 1.13-1.08 2.24-.64.95-1.31 1.9-2.37 1.92-1.07.02-1.38-.65-2.59-.65-1.21 0-1.56.63-2.57.67-1.03.04-1.81-1.03-2.46-1.97C6.59 16.48 5.59 12.99 6.97 10.61c.69-1.17 1.92-1.92 3.25-1.95 1.02-.02 1.97.69 2.59.69.62 0 1.78-.85 3-.72.5.02 1.94.21 2.85 1.54-.07.05-1.71.96-1.69 3.27zM14.77 7.34c.55-.67.91-1.6.81-2.51-.78.03-1.73.52-2.29 1.2-.52.6-.96 1.54-.85 2.43.88.07 1.77-.47 2.33-1.12z"
              ></path>
            </svg>
            {t("hero.cta.appstore")}
          </a>
          <a
            href="https://play.google.com/store/apps/details?id=com.stouph.netbudget"
            target="_blank"
            rel="noopener"
            class="btn-primary"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 20.5V3.5c0-.59.34-1.11.84-1.35L13.69 12 3.84 21.85A1.53 1.53 0 0 1 3 20.5zm13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27zm3.35-4.31c.34.27.59.69.59 1.19s-.25.92-.59 1.19l-2.27 1.31L15.39 12l2.5-2.5 2.27 1.31zM6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66z"></path>
            </svg>
            {t("hero.cta.googleplay")}
          </a>
          <a href="#features" class="btn-secondary">
            {t("hero.cta.learn")}
          </a>
        </div>

        <p class="text-xs text-text-3">{t("hero.note")}</p>
      </div>

      <!-- Right: animation de logo, muette, dans une carte premium -->
      <div class="relative flex justify-center md:justify-end">
        <!-- Halo ambiant "respirant" derrière la carte -->
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -inset-8 -z-10 rounded-[64px] bg-mint-500/15 blur-3xl animate-float"
        >
        </div>

        <div
          class="relative aspect-[521/360] w-full max-w-[440px] overflow-hidden rounded-[28px] border border-white/10 bg-[#121D33] shadow-[0_40px_90px_-24px_rgba(0,0,0,0.7),0_0_60px_-12px_rgba(110,231,183,0.3)] sm:max-w-[500px] md:max-w-[540px] lg:max-w-[580px]"
        >
          <video
            id="hero-spot-video"
            class="h-full w-full object-cover"
            src={videoSrc}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            aria-label={t("spot.title")}
          >
          </video>

          {/* HIG « Let people control audio and video playback » : une vidéo
              lancée seule doit pouvoir être arrêtée. Le bouton fait 44 px et
              dit ce qu'il fait ; sous « Réduire les animations », la vidéo ne
              démarre pas et le bouton propose de la lancer. */}
          <button
            id="hero-spot-toggle"
            type="button"
            class="absolute bottom-3 right-3 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-ink-900/70 text-text-1 backdrop-blur transition hover:bg-ink-900/90"
            aria-pressed="true"
            aria-label={t("hero.video.pause")}
            data-label-pause={t("hero.video.pause")}
            data-label-play={t("hero.video.play")}
          >
            <svg data-icon="pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="6" y="5" width="4" height="14" rx="1"></rect>
              <rect x="14" y="5" width="4" height="14" rx="1"></rect>
            </svg>
            <svg data-icon="play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="hidden">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </button>

          <!-- Liseré interne subtil pour la finition verre -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 rounded-[28px] ring-1 ring-inset ring-white/5"
          >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    const video = document.getElementById("hero-spot-video");
    const toggle = document.getElementById("hero-spot-toggle");
    if (!video) return;

    // L'utilisateur a le dernier mot : une fois qu'il a mis en pause, on ne
    // relance plus au défilement. Sous « Réduire les animations », la vidéo
    // est arrêtée d'office, comme si la personne l'avait demandé.
    const reduced =
      window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let wanted = !reduced;

    function render() {
      if (!toggle) return;
      toggle.setAttribute("aria-pressed", wanted ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        wanted ? toggle.dataset.labelPause : toggle.dataset.labelPlay,
      );
      const pause = toggle.querySelector('[data-icon="pause"]');
      const play = toggle.querySelector('[data-icon="play"]');
      if (pause) pause.classList.toggle("hidden", !wanted);
      if (play) play.classList.toggle("hidden", wanted);
    }
    function playIfWanted() {
      if (!wanted) return;
      const p = video.play();
      if (p && typeof p.catch === "function") p.catch(function () {});
    }

    if (reduced) {
      video.removeAttribute("autoplay");
      video.pause();
    }
    render();

    if (toggle) {
      toggle.addEventListener("click", function () {
        wanted = !wanted;
        if (wanted) playIfWanted();
        else video.pause();
        render();
      });
    }

    // Vidéo muette en boucle : pause hors écran, reprise au retour
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) playIfWanted();
            else video.pause();
          });
        },
        { threshold: 0.3 },
      );
      io.observe(video);
    }
  })();
</script>
