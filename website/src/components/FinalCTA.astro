---
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative">
  <div class="container-app pb-24">
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-mint-500/15 via-cyan-400/5 to-transparent p-10 text-center md:p-16">
      <div aria-hidden="true" class="absolute -top-20 left-1/2 -z-10 h-[300px] w-[600px] -translate-x-1/2 rounded-full bg-gradient-radial from-mint-500/20 to-transparent blur-2xl"></div>
      <h2 class="heading-2 text-balance reveal">{t("cta.title")}</h2>
      <p class="body-lg mx-auto mt-4 max-w-xl text-balance reveal">{t("cta.subtitle")}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3 reveal">
        <a href="https://apps.apple.com/app/netbudget/id6763551701" target="_blank" rel="noopener" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 14.44c.02 2.15 1.94 2.76 1.95 2.78-.02.05-.33 1.13-1.08 2.24-.64.95-1.31 1.9-2.37 1.92-1.07.02-1.38-.65-2.59-.65-1.21 0-1.56.63-2.57.67-1.03.04-1.81-1.03-2.46-1.97C6.59 16.48 5.59 12.99 6.97 10.61c.69-1.17 1.92-1.92 3.25-1.95 1.02-.02 1.97.69 2.59.69.62 0 1.78-.85 3-.72.5.02 1.94.21 2.85 1.54-.07.05-1.71.96-1.69 3.27zM14.77 7.34c.55-.67.91-1.6.81-2.51-.78.03-1.73.52-2.29 1.2-.52.6-.96 1.54-.85 2.43.88.07 1.77-.47 2.33-1.12z"/>
          </svg>
          {t("cta.button")}
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.stouph.netbudget" target="_blank" rel="noopener" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 20.5V3.5c0-.59.34-1.11.84-1.35L13.69 12 3.84 21.85A1.53 1.53 0 0 1 3 20.5zm13.81-5.38L6.05 21.34l8.49-8.49 2.27 2.27zm3.35-4.31c.34.27.59.69.59 1.19s-.25.92-.59 1.19l-2.27 1.31L15.39 12l2.5-2.5 2.27 1.31zM6.05 2.66l10.76 6.22-2.27 2.27L6.05 2.66z"/>
          </svg>
          {t("cta.button.android")}
        </a>
      </div>
    </div>
  </div>
</section>
