---
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const FORM_URL = "https://forms.gle/2YgnD2ReFVGpnXCa6";
---

<section id="premium-waitlist" class="relative">
  <div class="container-app pb-16">
    <div class="reveal relative overflow-hidden rounded-3xl border border-mint-500/20 bg-gradient-to-br from-mint-500/10 via-transparent to-cyan-400/5 p-8 text-center md:p-12">
      <div
        aria-hidden="true"
        class="absolute -top-24 left-1/2 -z-10 h-[280px] w-[560px] -translate-x-1/2 rounded-full bg-gradient-radial from-mint-500/20 to-transparent blur-2xl"
      >
      </div>

      <span class="eyebrow">{t("waitlist.eyebrow")}</span>

      <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-mint-500/30 bg-mint-500/10 px-4 py-1.5 text-xs font-semibold text-mint-400">
        {t("waitlist.badge")}
      </div>

      <h2 class="heading-2 mx-auto mt-5 max-w-2xl text-balance">{t("waitlist.title")}</h2>
      <p class="body-lg mx-auto mt-4 max-w-xl text-balance">{t("waitlist.subtitle")}</p>

      <a
        href={FORM_URL}
        target="_blank"
        rel="noopener"
        class="btn-primary mt-8 inline-flex"
      >
        {t("waitlist.cta")}
      </a>

      <p class="mt-4 text-xs text-text-3">{t("waitlist.note")}</p>
    </div>
  </div>
</section>
