---
// Foire aux questions.
//
// Construite en <details>/<summary> et non en JavaScript : les réponses sont
// dans le HTML, donc lisibles par les moteurs, par les lecteurs d'écran, et
// trouvables avec la recherche du navigateur même replié. Un accordéon en JS
// cache le texte à tout le monde sauf à la souris.
//
// Les questions ne sont pas décoratives : ce sont celles qui décident d'un
// téléchargement — combien ça coûte, où vont mes données, est-ce que ça marche
// dans mon pays. Répondre franchement à « c'est payant ? » vaut mieux que
// laisser le doute.
import { useTranslations, type Locale } from "../i18n/utils";
import { FAQ_HOME_COUNT, FAQ_IDS } from "../lib/faq";

interface Props {
  locale: Locale;
  /** Compact : version courte intégrée à l'accueil. */
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const t = useTranslations(locale);

// Sur l'accueil on n'en montre que cinq : une page d'accueil n'est pas une
// documentation, et les cinq premières couvrent l'essentiel des hésitations.
const ids = compact ? FAQ_IDS.slice(0, FAQ_HOME_COUNT) : FAQ_IDS;
---

<section id="faq" class="relative">
  <div class="container-app py-20 md:py-28">
    <div class="mx-auto max-w-3xl text-center reveal">
      <span class="eyebrow">{t("faq.eyebrow")}</span>
      <h2 class="heading-2 mt-4 text-balance">{t("faq.title")}</h2>
      <p class="body-lg mt-4 text-balance">{t("faq.intro")}</p>
    </div>

    <div class="mx-auto mt-12 max-w-3xl divide-y divide-white/[0.07]">
      {
        ids.map((id, i) => (
          <details
            class="group reveal py-5"
            style={`animation-delay: ${i * 40}ms`}
            name={compact ? undefined : "faq"}
          >
            <summary
              class="flex cursor-pointer list-none items-start justify-between gap-4 text-left"
            >
              <h3 class="text-base font-semibold text-text-1 md:text-[17px]">
                {t(`faq.${id}.q`)}
              </h3>
              <span
                aria-hidden="true"
                class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full border border-white/10 text-text-3 transition group-open:rotate-45 group-open:border-mint-500/40 group-open:text-mint-400"
              >
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                >
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-2xl pr-10 text-[15px] leading-relaxed text-text-2">
              {t(`faq.${id}.a`)}
            </p>
          </details>
        ))
      }
    </div>

    {
      compact ? (
        <div class="mt-10 text-center">
          <a
            href={locale === "en" ? "/en/faq" : "/faq"}
            class="inline-flex items-center gap-2 text-sm font-semibold text-mint-400 transition hover:text-mint-300"
          >
            {t("faq.seeAll")}
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </a>
        </div>
      ) : null
    }
  </div>
</section>
