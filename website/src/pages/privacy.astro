---
// Page légale. Le fil d'Ariane sert autant à l'écran qu'aux résultats de
// recherche, où le balisage BreadcrumbList remplace l'URL brute par un chemin
// lisible sous le titre.
import Layout from "../layouts/Layout.astro";
import LegalPage from "../components/LegalPage.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { useTranslations } from "../i18n/utils";

const locale = "fr" as const;
const t = useTranslations(locale);

const crumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t("breadcrumb.home"), item: "https://netbudget.app/" },
    { "@type": "ListItem", position: 2, name: t("page.privacy.title"), item: "https://netbudget.app/privacy/" },
  ],
};
---

<Layout
  locale={locale}
  title={`${t("page.privacy.title")} — NETbudget`}
  description={t("page.privacy.desc")}
  pageKind="page" ogImage="/og-privacy.png"
  schema={crumbSchema}
  hideStickyCta={true}
>
  <div class="container-app pt-8">
    <Breadcrumb locale={locale} items={[{ label: t("page.privacy.title") }]} />
  </div>
  <LegalPage locale={locale} kind="privacy" updated="2026-08-22" />
</Layout>
