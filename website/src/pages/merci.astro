---
// Page de remerciement, atteinte après un envoi de message.
//
// Elle n'est PAS indexée (voir noindex) : entrer sur le site par un « merci »
// alors qu'on n'a rien envoyé est déroutant, et elle ne répond à aucune
// recherche.
//
// Elle ne se contente pas de remercier : elle dit QUAND une réponse arrive, et
// propose la suite. Un cul-de-sac poli reste un cul-de-sac.
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { useTranslations, localizedPath } from "../i18n/utils";

const locale = "fr" as const;
const t = useTranslations(locale);

const APP_STORE = "https://apps.apple.com/app/netbudget/id6763551701";
---

<Layout
  locale={locale}
  title={`${t("page.thanks.title")} — NETbudget`}
  description={t("page.thanks.desc")}
  pageKind="page"
  noindex={true}
  hideStickyCta={true}
>
  <div class="container-app pt-8">
    <Breadcrumb locale={locale} items={[{ label: t("page.thanks.title") }]} />
  </div>

  <section class="container-app py-16 md:py-24">
    <div class="mx-auto max-w-xl text-center">
      <span
        class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-mint-500/12 text-mint-400 ring-1 ring-mint-500/30"
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </span>

      <h1 class="heading-2 mt-6 text-balance">{t("page.thanks.h1")}</h1>
      <p class="body-lg mt-4 text-balance">{t("page.thanks.body")}</p>
      <p class="mt-3 text-sm text-text-3">{t("page.thanks.delay")}</p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={APP_STORE}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-mint-500 px-5 py-3 text-sm font-bold text-ink-900 transition hover:bg-mint-400"
        >
          {t("hero.cta.appstore")}
        </a>
        <a
          href={localizedPath(locale, "/faq/")}
          class="rounded-xl border border-white/12 bg-white/[0.04] px-5 py-3 text-sm font-semibold text-text-1 transition hover:border-mint-500/40"
        >
          {t("nf.faq")}
        </a>
      </div>

      <p class="mt-10 text-sm text-text-2">
        {t("page.thanks.follow")}
        <a
          href="https://www.instagram.com/netbudget.app"
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-mint-400 transition hover:text-mint-300"
        >
          Instagram
        </a>
      </p>
    </div>
  </section>
</Layout>
