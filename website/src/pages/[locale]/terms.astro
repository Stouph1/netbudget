---
// Page légale. Le fil d'Ariane sert autant à l'écran qu'aux résultats de
// recherche, où le balisage BreadcrumbList remplace l'URL brute par un chemin
// lisible sous le titre.
import Layout from "../../layouts/Layout.astro";
import LegalPage from "../../components/LegalPage.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { useTranslations, localizedPath, pagePath, LOCALES, DEFAULT_LOCALE, type Locale } from "../../i18n/utils";

export function getStaticPaths() {
  return LOCALES.filter((l) => l.code !== DEFAULT_LOCALE).map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
const SITE = "https://www.netbudget.app";
const t = useTranslations(locale);

const crumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t("breadcrumb.home"), item: new URL(localizedPath(locale, "/"), SITE).href },
    { "@type": "ListItem", position: 2, name: t("page.terms.title"), item: new URL(localizedPath(locale, "/terms"), SITE).href },
  ],
};
---

<Layout
  locale={locale}
  title={`${t("page.terms.title")} — NETbudget`}
  description={t("page.terms.desc")}
  pageKind="page"
  schema={crumbSchema}
  hideStickyCta={true}
>
  <div class="container-app pt-8">
    <Breadcrumb locale={locale} items={[{ label: t("page.terms.title") }]} />
  </div>
  <LegalPage locale={locale} kind="terms" updated="2026-11-04" />
</Layout>
