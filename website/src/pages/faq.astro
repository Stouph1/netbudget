---
// Page FAQ complète, avec balisage FAQPage : c'est ce qui permet à une réponse
// d'apparaître directement dans les résultats de recherche, sans clic.
import Layout from "../layouts/Layout.astro";
import Faq from "../components/Faq.astro";
import { FAQ_IDS } from "../lib/faq";
import Breadcrumb from "../components/Breadcrumb.astro";
import FinalCTA from "../components/FinalCTA.astro";
import { useTranslations } from "../i18n/utils";

const locale = "fr" as const;
const t = useTranslations(locale);

// Le balisage reprend EXACTEMENT le texte affiché : une réponse structurée qui
// diffère de la page visible est une raison de déclassement.
const faqSchema = {
  "@type": "FAQPage",
  mainEntity: FAQ_IDS.map((id) => ({
    "@type": "Question",
    name: t(`faq.${id}.q`),
    acceptedAnswer: { "@type": "Answer", text: t(`faq.${id}.a`) },
  })),
};

const crumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: t("breadcrumb.home"), item: "https://netbudget.app/" },
    { "@type": "ListItem", position: 2, name: t("faq.title"), item: "https://netbudget.app/faq/" },
  ],
};
---

<Layout
  locale={locale}
  title={`${t("page.faq.title")} — NETbudget`}
  description={t("page.faq.desc")}
  pageKind="page"
  ogImage="/og-faq.png"
  schema={{ "@graph": [faqSchema, crumbSchema] }}
>
  <div class="container-app pt-8">
    <Breadcrumb locale={locale} items={[{ label: t("faq.title") }]} />
  </div>
  <Faq locale={locale} />
  <FinalCTA locale={locale} />
</Layout>
